# UniEmailAgent 后端配置
# 复制此文件为 .env 并填入实际值

# DeepSeek API Key（用于意图分类、技能反思、进度总结）
# 如果只使用 Claude Code 爬取可以不配，但会降级为关键词分类
DEEPSEEK_API_KEY=

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Hermes 配置（智能编排引擎，可选）
# 如果安装了 Hermes CLI，Agent 会自动启用编排模式
# 安装: pip install hermes-agent


# LangSmith Tracing（全链路追踪，需 LANGCHAIN_API_KEY）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=UniEmailAgent

# 安全 Guardrails（log_only=仅记录不阻断, enforce=阻断）
GUARD_MODE=log_only

# Mem0 持久记忆（true/false，需安装 mem0ai）
MEM0_ENABLED=false

# LangGraph 状态机（true/false，启用后 hermes_agent.py 作为回退保留）
GRAPH_AGENT_ENABLED=false
